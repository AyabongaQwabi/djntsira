VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-maps-key
VITE_APP_URL=https://djntsira.umculo.app

# Canonical production site URL — used for canonical links, Open Graph/Twitter
# meta tags, JSON-LD structured data, and sitemap.xml generation (scripts/generate-sitemap.js).
# Read via import.meta.env.VITE_SITE_URL with a localhost fallback for dev.
VITE_SITE_URL=https://djntsira.umculo.app

# Server-side only (Supabase Edge Functions)
RESEND_API_KEY=your-resend-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Yoco Checkout API — from Yoco App → Payment Gateway
# Set via: supabase secrets set YOCO_SECRET_KEY=sk_test_... or sk_live_...
YOCO_SECRET_KEY=sk_test_your-secret-key
